#!/bin/bash
#
# Production codec sweep on Santis (Grace nodes, 288 cores/node): evaluate_combos
# over a list of DYAMOND fields, one results directory per field, optionally
# followed by compress.  Submit from the repository root, where venv/ lives:
#
#   DYAMOND_DATA_ROOT=/path/to/parent sbatch --account=<account> santis.run
#
# Topology: RANKS MPI ranks per node, one core each; the ranks of a node share one
# copy of the sample through an MPI shared-memory window.
#   - A rank evaluates one pipeline at a time, so the ranks are what scales.
#   - Compression is memory-bandwidth-bound here, so the codec libraries are
#     pinned to one thread: inner threads would compete for the same bandwidth.
#   - A node holds about (1 + 2 x RANKS) x the sample (the [memory] line).  The sweep
#     checks that against the node's memory and shrinks the sample to fit ([memcheck]).
#   docs/PARALLELIZATION.md has the details.
#
# Environment knobs:
#   DYAMOND_DATA_ROOT        parent dir of the Data_Dyamond_PostProcessed* trees (required)
#   RESULTS_BASE             output root (default ./res_folder_dyamond_<job id>).  Point it at an
#                            earlier run's directory to continue it: combos recorded on the same
#                            sample, chunking and codec build are reused and re-gated with the
#                            current thresholds; anything else restarts the field.
#   FIELDS_FILE              replaces the list below: one entry per line, same format
#   MAX_EVALS=N              cap the codec space (quick test runs)
#   WITH_EBCC=1              add the EBCC combos (float (lat, lon) fields; needs the ebcc package)
#   COMPRESS=1               write each swept file with its winner and verify it (one task)
#   STOCK_CODECS_ONLY=1      with COMPRESS=1: only pipelines a zarr client without dc_toolkit decodes
#   WALLTIME_SAFEGUARD_MIN   no field starts with fewer minutes left in the job (default 15)

#SBATCH --account=YOUR_ACCOUNT_HERE
#SBATCH --uenv=prgenv-gnu/26.3:v1
#SBATCH --view=default
#SBATCH --partition=normal
#SBATCH --nodes=8
#SBATCH --ntasks-per-node=32
#SBATCH --cpus-per-task=1
#SBATCH --time=12:00:00
#SBATCH --output=out-%j.out
#SBATCH --error=out-%j.out

set -uo pipefail   # NOT -e: continue past per-field failures

export PYTHONUNBUFFERED=1
source venv/bin/activate

export OMP_NUM_THREADS=1 \
       MKL_NUM_THREADS=1 \
       OPENBLAS_NUM_THREADS=1 \
       BLOSC_NTHREADS=1 \
       NUMBA_NUM_THREADS=1 \
       VECLIB_MAXIMUM_THREADS=1 \
       OMP_THREAD_LIMIT=1

# ---------------------------------------------------------------------------
# Tunables
# ---------------------------------------------------------------------------
: "${DYAMOND_DATA_ROOT:?export DYAMOND_DATA_ROOT=<parent dir of the Data_Dyamond_PostProcessed* trees>}"
ROOT_R02B10="$DYAMOND_DATA_ROOT/Data_Dyamond_PostProcessed"
ROOT_R02B08="$DYAMOND_DATA_ROOT/Data_Dyamond_PostProcessed_R02B08"
ROOT_R02B06="$DYAMOND_DATA_ROOT/Data_Dyamond_PostProcessed_R02B06"

RESULTS_BASE="${RESULTS_BASE:-./res_folder_dyamond_${SLURM_JOB_ID:-$$}}"
mkdir -p "$RESULTS_BASE"

DEFAULT_SAMPLE=2GiB     # --eval-data-size-limit of an entry that names none
DEFAULT_RANKS=32        # ranks per node of an entry that names none

EXTRA_FLAGS=()
MAX_EVALS="${MAX_EVALS:-}"
if [[ -n "$MAX_EVALS" && "$MAX_EVALS" != "0" ]]; then
    EXTRA_FLAGS+=(--max-evals "$MAX_EVALS")
fi
[[ "${WITH_EBCC:-0}" == 1 ]] && EXTRA_FLAGS+=(--with-ebcc)
COMPRESS_FLAGS=()
[[ "${STOCK_CODECS_ONLY:-0}" == 1 ]] && COMPRESS_FLAGS+=(--stock-codecs-only)

SAFEGUARD_MIN=${WALLTIME_SAFEGUARD_MIN:-15}
JOB_END=${SLURM_JOB_END_TIME:-}     # epoch seconds; empty outside a job, which disables the safeguard

echo "[santis.run] topology : up to ${SLURM_NTASKS_PER_NODE:-32} rank(s)/node x ${SLURM_JOB_NUM_NODES:-?} node(s), one shared sample per node"
echo "[santis.run] data root: $DYAMOND_DATA_ROOT"
echo "[santis.run] knobs    : MAX_EVALS='${MAX_EVALS}' WITH_EBCC=${WITH_EBCC:-0} COMPRESS=${COMPRESS:-0} STOCK_CODECS_ONLY=${STOCK_CODECS_ONLY:-0}"

# ---------------------------------------------------------------------------
# Field list
# ---------------------------------------------------------------------------
# Format:  RES|STREAM|FILE|IVAR|VAR|L1|SAMPLE|RANKS|GATE FLAGS
#   IVAR is the variable's name inside FILE (what is swept); VAR names the results
#   directory RES_STREAM_VAR.  They differ where several products share an in-file
#   name: SFC_lwflx_dn and TOA_lwflx_dn both hold lwflx_dn.
#   SAMPLE (--eval-data-size-limit) and RANKS (ranks per node) may be left empty.
#
# L1 is a RELATIVE budget (sum|err| / sum|orig|); the L2, Linf and bias gates default
# to 2x, 10x and 0.5x of it.  The budgets below allow a mean error of 0.5 % of the
# field's standard deviation (0.005 x std / |mean|), capped at 1 %: heavy-tailed
# fields reach the cap and carry --extremes-sensitive.
# GATE FLAGS are passed to evaluate_combos as they are: --phys-min/--phys-max for
# bounded fields (with --phys-tolerance for one that sits on its bound), --gradient-gate
# for fields whose gradients matter.
# SAMPLE and RANKS follow the field's size: 2GiB x 32 for most, 16 ranks and a
# 1-2 GiB sample for the large R02B10 fields, which halves what the ranks hold.
LIST=(
    # R02B06, 3-D
    "R02B06|out_1_1|remap_qv_20220225T000000Z.nc|qv|qv|0.01|2GiB|32|--gradient-gate --gradient-threshold 0.1 --gradient-shortcircuit --extremes-sensitive --phys-min 0"
    "R02B06|out_1_2|remap_qi_20220225T000000Z.nc|qi|qi|0.01|2GiB|32|--extremes-sensitive --phys-min 0"
    "R02B06|out_1_3|remap_temp_20220225T000000Z.nc|temp|temp|0.00056554|2GiB|32|--gradient-gate --gradient-threshold 0.1 --gradient-shortcircuit --phys-min 0"
    "R02B06|out_1_4|remap_w_20220225T000000Z.nc|w|w|0.00942309|2GiB|32|--gradient-gate --gradient-threshold 0.1 --gradient-shortcircuit"
    "R02B06|out_4|w_20220225T000000Z.nc|w|w|0.01|2GiB|32|--gradient-gate --gradient-threshold 0.1 --gradient-shortcircuit --extremes-sensitive"
    "R02B06|out_11|geopot_20220225T000000Z.nc|geopot|geopot|0.00341505|2GiB|32|--gradient-gate --gradient-threshold 0.1 --gradient-shortcircuit --phys-min 0"

    # R02B06, 2-D and soil
    "R02B06|out_2|tot_prec_20220225T000000Z.nc|tot_prec|tot_prec|0.01|2GiB|32|--extremes-sensitive --phys-min 0"
    "R02B06|out_3|t_2m_20220225T000000Z.nc|t_2m|t_2m|0.00028651|2GiB|32|--gradient-gate --gradient-threshold 0.1 --gradient-shortcircuit --phys-min 0"
    "R02B06|out_6|sob_s_20220225T000000Z.nc|sob_s|sob_s|0.00762046|2GiB|32|--phys-min 0"
    "R02B06|out_8|remap_cape_20220225T000000Z.nc|cape|cape|0.01|2GiB|32|--extremes-sensitive --phys-min 0"
    "R02B06|out_9|remap_t_so_20220225T000000Z.nc|t_so|t_so|0.00036228|2GiB|32|--phys-min 0"

    # R02B10
    "R02B10|out_1_1|remap_qv_20220225T000000Z.nc|qv|qv|0.01|2GiB|16|--gradient-gate --gradient-threshold 0.1 --gradient-shortcircuit --extremes-sensitive --phys-min 0"
    "R02B10|out_2|tot_prec_20220225T000000Z.nc|tot_prec|tot_prec|0.01|1GiB|16|--extremes-sensitive --phys-min 0"
)
if [[ -n "${FIELDS_FILE:-}" ]]; then
    [[ -r "$FIELDS_FILE" ]] || { echo "[santis.run] FIELDS_FILE is not readable: $FIELDS_FILE"; exit 1; }
    # indentation and quotes are dropped, so the lines of a generated list work as they are
    mapfile -t LIST < <(sed -E 's/^[[:space:]]*"?//; s/"?[[:space:]]*$//' "$FIELDS_FILE" | grep -Ev '^(#|$)')
fi

resolve_root () {
    case "$1" in
        R02B06) echo "$ROOT_R02B06" ;;
        R02B08) echo "$ROOT_R02B08" ;;
        R02B10) echo "$ROOT_R02B10" ;;
        *)      echo ""; return 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# Driver loop
# ---------------------------------------------------------------------------
n_total=${#LIST[@]}
n_ok=0; n_fail=0; n_skip=0
declare -a PROBLEMS=()

echo "======================================================================="
echo "dc_toolkit evaluate_combos sweep over ${n_total} field(s)"
echo "Results base: $RESULTS_BASE"
echo "Started at:   $(date -Is)"
[[ -n "$JOB_END" ]] && echo "Job ends at:  $(date -d "@$JOB_END" -Is) (safeguard ${SAFEGUARD_MIN} min)"
echo "======================================================================="

for i in "${!LIST[@]}"; do
    if [[ -n "$JOB_END" ]] && (( (JOB_END - $(date +%s)) / 60 < SAFEGUARD_MIN )); then
        echo
        echo "[safeguard] under ${SAFEGUARD_MIN} min left: $((n_total - i)) field(s) not started."
        echo "            Resubmit with RESULTS_BASE=$RESULTS_BASE to continue."
        n_skip=$((n_skip + n_total - i)); PROBLEMS+=("SKIP  $((n_total - i)) field(s) from entry $((i+1)) on  (walltime)")
        break
    fi

    IFS='|' read -r RES_TAG STREAM FNAME IVAR VAR L1_THRESHOLD SAMPLE RANKS GATES <<<"${LIST[$i]}"
    SAMPLE=${SAMPLE:-$DEFAULT_SAMPLE}; RANKS=${RANKS:-$DEFAULT_RANKS}

    if [[ -z "$VAR" || ! "$L1_THRESHOLD" =~ ^[0-9.]+([eE][-+]?[0-9]+)?$ || ! "$RANKS" =~ ^[1-9][0-9]*$ ]]; then
        echo "[$((i+1))/$n_total] SKIP malformed entry (RES|STREAM|FILE|IVAR|VAR|L1|...): ${LIST[$i]}"
        n_skip=$((n_skip+1)); PROBLEMS+=("SKIP  ${LIST[$i]}  (malformed)")
        continue
    fi
    ROOT=$(resolve_root "$RES_TAG") || {
        echo "[$((i+1))/$n_total] SKIP unknown resolution tag '$RES_TAG'"
        n_skip=$((n_skip+1)); PROBLEMS+=("SKIP  ${LIST[$i]}  (unknown resolution)")
        continue
    }
    INPUT="$ROOT/$STREAM/$FNAME"
    SUBDIR="${RES_TAG}_${STREAM}_${VAR}"
    OUTDIR="$RESULTS_BASE/$SUBDIR"

    echo
    echo "-----------------------------------------------------------------------"
    echo "[$((i+1))/$n_total] $SUBDIR"
    echo "  input    : $INPUT"
    echo "  field    : $IVAR"
    echo "  l1 thresh: $L1_THRESHOLD"
    echo "  sample   : $SAMPLE, $RANKS rank(s)/node"
    echo "  gates    : ${GATES:-(defaults)}"
    echo "  outdir   : $OUTDIR"

    if [[ ! -e "$INPUT" ]]; then
        echo "  STATUS: SKIP - input file not found"
        n_skip=$((n_skip+1)); PROBLEMS+=("SKIP  $SUBDIR  (missing input)")
        continue
    fi
    mkdir -p "$OUTDIR"

    # $GATES is split on purpose: it holds several flags.  --ntasks is explicit, since the
    # job's SLURM_NTASKS would otherwise override --ntasks-per-node.
    srun --unbuffered --nodes="$SLURM_JOB_NUM_NODES" --ntasks=$(( SLURM_JOB_NUM_NODES * RANKS )) \
         --ntasks-per-node="$RANKS" --cpus-per-task=1 dc_toolkit \
         evaluate_combos \
         "$INPUT" \
         --where-to-write              "$OUTDIR" \
         --field-to-compress           "$IVAR" \
         --l1-threshold                "$L1_THRESHOLD" \
         --eval-data-size-limit        "$SAMPLE" \
         $GATES "${EXTRA_FLAGS[@]}" \
         2>&1 | stdbuf -oL -eL tee "$OUTDIR/run.log"
    rc=${PIPESTATUS[0]}; step=sweep

    if [[ $rc -eq 0 && "${COMPRESS:-0}" == 1 ]]; then
        # compress is one process: dask's threads need the node's cores
        srun --unbuffered --nodes=1 --ntasks=1 --cpus-per-task=32 dc_toolkit \
             compress "$INPUT" "$OUTDIR" --vars "$IVAR" "${COMPRESS_FLAGS[@]}" \
             2>&1 | stdbuf -oL -eL tee "$OUTDIR/compress.log"
        rc=${PIPESTATUS[0]}; step=compress
    fi

    if [[ $rc -eq 0 ]]; then
        echo "  STATUS: OK"
        n_ok=$((n_ok+1))
    else
        echo "  STATUS: FAILED ($step, exit $rc)"
        n_fail=$((n_fail+1)); PROBLEMS+=("FAIL  $SUBDIR  ($step, exit $rc)")
    fi
done

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo
echo "======================================================================="
echo "Summary"
echo "  total      : $n_total"
echo "  ok         : $n_ok"
echo "  failed     : $n_fail"
echo "  skipped    : $n_skip"
echo "  results    : $RESULTS_BASE"
echo "  finished at: $(date -Is)"
if (( n_fail + n_skip > 0 )); then
    echo "  problems:"
    for p in "${PROBLEMS[@]}"; do
        echo "    $p"
    done
fi
echo "======================================================================="

(( n_total > 0 && n_ok == n_total ))   # the exit status: 0 only when every field ran
